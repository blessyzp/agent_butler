# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ── 云端 LLM 兜底（游戏/资源紧张时使用）──
# 注册 https://platform.deepseek.com 获取，充值 ¥10 可用很久
DEEPSEEK_API_KEY=

# ── 通知推送（三选一或多选）──
# Bark（iOS，推荐自建）：安装 Bark App 后获取 key，或填自建服务器地址
BARK_KEY=
BARK_SERVER=https://api.day.app

# Telegram Bot：找 @BotFather 创建，获取 token 和你的 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 加密主密码（可选）──
# 留空则首次运行时交互式输入，并存入系统密钥链
BUTLER_MASTER_PASSWORD=
